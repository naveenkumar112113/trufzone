PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
REDIS_URL=redis://<redis-host>:<port>
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
# In Render: Set this to your live Vercel frontend URL (without trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Optional comma-separated origins (custom domains, previews, local dev)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com,http://localhost:3000
